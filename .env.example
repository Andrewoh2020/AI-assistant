# Copy to .env (at the top of the repository) for local development. Never commit real values.
# In the cloud environment these hosts get their keys from network secrets instead.

# Postgres (local dev default shown)
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ai_assistant

# Travila (agent runs, models, memory). Secret key with users:impersonate + conversations:read
TRAVILA_API_BASE=https://api.travila.ai
TRAVILA_API_KEY=

# DeepSeek Search + Fetch (web_search, fetch_page)
DEEPSEEK_API_KEY=

# Browser Use (the browse tool: a real browser for JavaScript pages, sign-ins, forms and files)
BROWSER_USE_API_KEY=

# Signs session cookies. Can stay empty on your computer; the hosted site needs 32+ random characters.
SESSION_SECRET=
# People need this code to create an account. Leave empty to turn sign-up off.
SIGNUP_CODE=

# Leave unset: the website runs the backend itself. Set it only to use a separately started
# backend (pnpm --filter @ai-assistant/api start), e.g. API_URL=http://localhost:4000
# API_URL=
