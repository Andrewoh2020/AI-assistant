{
  "name": "ai-assistant",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r build",
    "dev": "pnpm -r --parallel dev",
    "start": "pnpm --filter @ai-assistant/web start",
    "local": "pnpm build && pnpm db:migrate && pnpm start",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check:secrets": "node scripts/check-secrets.mjs",
    "db:migrate": "pnpm --filter @ai-assistant/db migrate up",
    "db:rollback": "pnpm --filter @ai-assistant/db migrate down"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "prettier": "^3.9.10",
    "typescript": "^6.0.3",
    "vitest": "^5.0.5"
  },
  "pnpm": {
    "overrides": {
      "light-my-request>cookie": "1.1.1"
    }
  }
}
