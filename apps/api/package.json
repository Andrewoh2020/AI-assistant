{
  "name": "@ai-assistant/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "node --env-file-if-exists=../../.env --watch dist/server.js",
    "start": "node --env-file-if-exists=../../.env dist/server.js",
    "test": "vitest run"
  },
  "dependencies": {
    "@ai-assistant/agent": "workspace:*",
    "@ai-assistant/db": "workspace:*",
    "@fastify/cookie": "^11.1.3",
    "fastify": "^5.12.7",
    "@ai-assistant/api-client": "workspace:*"
  }
}
